---
import "../styles/global.css";
// Metadatos de la demo. La URL canónica usa el dominio configurado en Astro.
const seoTitle =
  "Gimnasio en Barcelona · Fuerza y clases en grupo | A Tu Ritmo";
const seoDescription =
  "Demo de gimnasio en Barcelona: entrenamiento personal, fuerza, boxeo, spinning y yoga. Descubre A Tu Ritmo, una creación de DPM Evolución Digital.";
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const shareImage = Astro.site
  ? new URL("/demo-gimnasio-gym/images/hero.webp", Astro.site)
  : undefined;

const trainings = [
  {
    title: "Fuerza",
    image: "fuerza",
    alt: "Una persona entrena con una barra en la sala de fuerza",
    desc: "Aprende a entrenar con pesas y máquinas para desarrollar fuerza y mejorar tu condición física.",
  },
  {
    title: "Funcional",
    image: "funcional",
    alt: "Una mujer realiza ejercicios con cuerdas de entrenamiento",
    desc: "Trabaja fuerza, resistencia y coordinación con ejercicios variados y adaptados a tu nivel.",
  },
  {
    title: "Entrenamiento personal",
    image: "personal",
    alt: "Un entrenador acompaña a una mujer durante una sesión personal",
    desc: "Entrena con un profesional que te acompaña y adapta las sesiones a tus objetivos.",
  },
  {
    title: "Movilidad",
    image: "movilidad",
    alt: "Una mujer realiza un estiramiento lateral sobre una esterilla",
    desc: "Trabaja la amplitud de movimiento y el control corporal con ejercicios de movilidad.",
  },
];
const classes = [
  {
    title: "Circuito",
    image: "circuito",
    tag: "ENERGÍA EN EQUIPO",
    desc: "Un entrenamiento completo para salir con otra energía.",
  },
  {
    title: "Fuerza en grupo",
    image: "grupo",
    tag: "JUNTOS, MÁS FUERTES",
    desc: "Técnica, fuerza y un grupo que te acompaña.",
  },
  {
    title: "Movilidad",
    image: "movilidad-grupo",
    tag: "MUÉVETE A TU RITMO",
    desc: "Recupera amplitud, equilibrio y buenas sensaciones.",
  },
  {
    title: "Boxeo",
    image: "boxeo",
    tag: "ENCUENTRA TU GOLPE",
    desc: "Aprende técnica, trabaja tu coordinación y libera energía.",
  },
  {
    title: "Spinning",
    image: "spinning",
    tag: "PEDALEA CON OTRA ENERGÍA",
    desc: "Música, resistencia y un grupo que te impulsa a seguir.",
  },
  {
    title: "Yoga",
    image: "yoga",
    tag: "ENCUENTRA TU EQUILIBRIO",
    desc: "Conecta movimiento y respiración. Dedícate un momento para ti.",
  },
];
const faqs = [
  [
    "¿Puedo empezar en el gimnasio sin experiencia?",
    "Sí. La propuesta de A Tu Ritmo es acompañarte desde tu nivel. La primera sesión sirve para conocer tus objetivos y orientarte con los ejercicios y la intensidad, aunque lleves tiempo sin hacer deporte.",
  ],
  [
    "¿Qué diferencia hay entre entrenamiento personal y clases en grupo?",
    "El entrenamiento personal permite trabajar con atención individual y sesiones adaptadas a tus objetivos. Las clases en grupo siguen una actividad compartida, con orientación durante los ejercicios y la motivación de entrenar acompañado.",
  ],
  [
    "¿Qué clases en grupo puedo descubrir?",
    "Esta demo presenta circuito, fuerza en grupo, movilidad, boxeo, spinning y yoga. Explora las tarjetas y consulta los horarios de ejemplo para conocer la propuesta.",
  ],
  [
    "¿Qué actividad puedo elegir si estoy empezando?",
    "Depende de tus preferencias y de tu punto de partida. Puedes explorar el trabajo de fuerza, el entrenamiento funcional, la movilidad o las clases dirigidas. En una primera sesión, el equipo te orientaría para elegir una actividad y una intensidad adecuadas.",
  ],
  [
    "¿Qué tengo que llevar a una primera sesión?",
    "Ropa cómoda, una toalla y agua. Para la sala de fuerza y las actividades de cardio, lleva zapatillas deportivas. En actividades como yoga, consulta antes el material y el calzado necesarios.",
  ],
  [
    "¿Cómo puedo reservar una sesión de prueba?",
    "Puedes probar el formulario y seleccionar una franja horaria. A Tu Ritmo es una demo de DPM Evolución Digital: no se envían ni guardan los datos y no se genera una reserva real.",
  ],
  [
    "¿Dónde está el gimnasio y cuáles son sus tarifas?",
    "A Tu Ritmo es una demostración de diseño web para un gimnasio en Barcelona. No representa un centro abierto al público ni dispone de dirección o tarifas comerciales. Los horarios que se muestran son ilustrativos.",
  ],
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="A Tu Ritmo · Demo DPM" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.href} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl.href} />}
    {shareImage && <meta property="og:image" content={shareImage.href} />}
    {shareImage && (
      <meta
        property="og:image:alt"
        content="Una entrenadora acompaña a una mujer durante su entrenamiento de fuerza"
      />
    )}
    <link
      rel="icon"
      type="image/svg+xml"
      href="/demo-gimnasio-gym/favicon.svg"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="header">
      <div class="header-inner">
        <a class="header-logo" href="#inicio" aria-label="GYM, inicio">
          <img
            src="/demo-gimnasio-gym/images/logo-gym.png"
            alt="GYM"
            width="1920"
            height="819"
            loading="eager"
          />
        </a>
        <nav id="main-nav" aria-label="Navegación principal">
          <a href="#clases">Clases</a>
          <a href="#gimnasio">El gimnasio</a>
          <a href="#comunidad">Comunidad</a>
        </nav>
        <a class="button header-cta" href="#reserva">
          Reserva tu prueba <span aria-hidden="true">↗</span>
        </a>
        <button
          class="menu-toggle"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="main-nav"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>
    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src="/demo-gimnasio-gym/images/hero.webp"
          alt="Una entrenadora acompaña a una mujer durante su entrenamiento de fuerza"
          fetchpriority="high"
          width="1536"
          height="1024"
        />
        <div class="hero-shade"></div>
        <div class="hero-content container">
          <p class="eyebrow">
            <span></span> BARCELONA · TU BARRIO. TU GIMNASIO.
          </p>
          <h1 id="hero-title">
            Gimnasio
            <br />
            en Barcelona.
          </h1>
          <p class="hero-promise">
            Tu objetivo,
            <br />
            nuestro compromiso.
          </p>
          <p class="hero-subtitle">
            Entrenamiento personal, fuerza y clases en grupo. Empieza desde tu
            nivel, con acompañamiento desde el primer día.
          </p>
          <div class="hero-actions">
            <a class="button" href="#reserva">
              Reserva tu sesión de prueba <span aria-hidden="true">↗</span>
            </a>
            <button class="button button-white" data-spot>
              Tú puedes <span aria-hidden="true">▶</span>
            </button>
          </div>
        </div>
        <div class="hero-bottom container">
          <span>FUERZA · CONFIANZA · COMUNIDAD</span>
          <a href="#entrenamientos" aria-label="Descubre los entrenamientos">
            BAJA Y DESCÚBRELO <span aria-hidden="true">↓</span>
          </a>
        </div>
      </section>

      <section
        class="rhythm-banner"
        aria-label="No hace falta entrenar como Rocky. Hace falta encontrar tu ritmo. Los campeones también empezaron un día. Hoy puede ser el tuyo."
      >
        <div class="rhythm-banner__inner">
          <div class="rhythm-banner__messages" aria-hidden="true">
            <p class="rhythm-banner__message is-active">
              <span class="rhythm-banner__line">
                NO HACE FALTA ENTRENAR COMO ROCKY.
              </span>
              <span class="rhythm-banner__line">
                HACE FALTA ENCONTRAR TU RITMO.
              </span>
            </p>

            <p class="rhythm-banner__message">
              <span class="rhythm-banner__line">
                LOS CAMPEONES TAMBIÉN EMPEZARON UN DÍA.
              </span>
              <span class="rhythm-banner__line">HOY PUEDE SER EL TUYO.</span>
            </p>
          </div>

          <span class="rhythm-banner__arrow" aria-hidden="true">
            ↗
          </span>

          <button
            class="rhythm-banner__pause"
            type="button"
            aria-pressed="false"
          >
            Pausar animación
          </button>
        </div>
      </section>

      <section class="section" id="entrenamientos">
        <div class="section-heading">
          <h2>
            Fuerza, funcional
            <br />y entrenamiento personal
          </h2>
        </div>
        <p class="section-intro">
          Espacios para entrenar, cuidarte y desconectar. Descubre nuestra sala
          de fuerza, zona funcional y ring de boxeo, además de las cabinas de
          fisioterapia, la sauna, los vestuarios y la zona de relax.
        </p>
        <div class="training-grid">
          {trainings.map((item, i) => (
            <a class="training-card" href="#reserva">
              <div class="image-wrap">
                <img
                  src={`/demo-gimnasio-gym/images/${item.image}.webp`}
                  alt={item.alt}
                  width="320"
                  height="490"
                  loading="lazy"
                />
                <span class="card-number">0{i + 1}</span>
                <span class="card-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </a>
          ))}
        </div>
      </section>
      <section class="section classes-section" id="clases">
        <div class="classes-inner">
          <div class="section-heading">
            <div>
              <p class="eyebrow">BUENA ENERGÍA. MEJOR COMPAÑÍA.</p>
              <h2>
                Clases en grupo
                <br />
                en Barcelona
              </h2>
            </div>
            <div class="slider-controls">
              <div class="slider-dots" aria-hidden="true">
                {classes.map((_, index) => (
                  <i class:list={{ active: index === 0 }}></i>
                ))}
              </div>
              <button data-slide="-1" aria-label="Clases anteriores">
                ←
              </button>
              <button data-slide="1" aria-label="Clases siguientes">
                →
              </button>
            </div>
          </div>
          <p class="section-intro">
            Circuito, fuerza, movilidad, boxeo, spinning y yoga. Descubre
            diferentes formas de entrenar acompañado y encuentra la actividad
            que mejor encaja contigo.
          </p>
          <div
            class="class-slider"
            tabindex="0"
            aria-label="Clases de entrenamiento"
          >
            {classes.map((item) => (
              <article class="class-card">
                <img
                  src={`/demo-gimnasio-gym/images/${item.image}.webp`}
                  alt={`Entrenamiento de ${item.title.toLowerCase()}`}
                  width="500"
                  height="450"
                  loading="lazy"
                />
                <div class="class-info">
                  <span>{item.tag}</span>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </div>
              </article>
            ))}
          </div>
          <div class="center">
            <button class="button" id="schedule-open">
              Ver horarios <span aria-hidden="true">↗</span>
            </button>
          </div>
        </div>
      </section>
      <section class="spot-section" id="spot">
        <img
          src="/demo-gimnasio-gym/images/spot.webp"
          alt="Detalle de una mano sujetando una mancuerna en el gimnasio"
          width="650"
          height="650"
          loading="lazy"
        />
        <div class="spot-gradient"></div>

        <div class="spot-content">
          <p class="eyebrow">EMPIEZA DESDE TU NIVEL</p>

          <h2>
            Gimnasio para
            <br />
            principiantes
          </h2>

          <p class="spot-description">
            ¿Quieres empezar a entrenar o volver a hacer deporte? En GYM te
            acompañamos desde el primer día, con ejercicios adaptados a tu nivel
            y a tus objetivos.
          </p>

          <button class="play-link" data-spot>
            <span class="play-circle" aria-hidden="true">
              ▶
            </span>
            Tú puedes
          </button>
        </div>
      </section>
      <section class="section" id="gimnasio">
        <div class="section-heading">
          <h2>
            Conoce el
            <br />
            gimnasio
          </h2>
          <p>Un espacio para dar tu siguiente paso.</p>
        </div>
        <p class="section-intro">
          Espacios para entrenar, cuidarte y desconectar. Descubre nuestra sala
          de fuerza, zona funcional y ring de boxeo, además de las cabinas de
          fisioterapia, la sauna, los vestuarios y la zona de relax.
        </p>

        <div class="spaces-controls" aria-label="Controles de instalaciones">
          <button
            type="button"
            data-space-direction="-1"
            aria-label="Ver instalaciones anteriores"
            aria-controls="spaces-slider"
          >
            ←
          </button>
          <button
            type="button"
            data-space-direction="1"
            aria-label="Ver instalaciones siguientes"
            aria-controls="spaces-slider"
          >
            →
          </button>
        </div>
        <div
          class="spaces-slider"
          id="spaces-slider"
          tabindex="0"
          role="region"
          aria-label="Instalaciones del gimnasio"
        >
          <figure>
            <img
              src="/demo-gimnasio-gym/images/sala.webp"
              alt="Sala de fuerza con bancos, barras y discos"
              width="900"
              height="550"
              loading="lazy"
            />
            <figcaption>Sala de fuerza</figcaption>
          </figure>

          <figure>
            <img
              src="/demo-gimnasio-gym/images/zona.webp"
              alt="Zona de entrenamiento funcional con kettlebells y cuerdas"
              width="900"
              height="550"
              loading="lazy"
            />
            <figcaption>Zona funcional</figcaption>
          </figure>

          <figure>
            <img
              src="/demo-gimnasio-gym/images/ring-boxeo.webp"
              alt="Ring de boxeo en el gimnasio"
              width="900"
              height="550"
              loading="lazy"
            />
            <figcaption>Ring de boxeo</figcaption>
          </figure>

          <figure>
            <img
              src="/demo-gimnasio-gym/images/fisioterapia.webp"
              alt="Cabina de fisioterapia con camilla"
              width="900"
              height="550"
              loading="lazy"
            />
            <figcaption>Cabinas de fisioterapia</figcaption>
          </figure>

          <figure>
            <img
              src="/demo-gimnasio-gym/images/sauna.webp"
              alt="Interior de la sauna con bancos de madera"
              width="900"
              height="550"
              loading="lazy"
            />
            <figcaption>Sauna</figcaption>
          </figure>

          <figure>
            <img
              src="/demo-gimnasio-gym/images/vestuarios.webp"
              alt="Vestuarios del gimnasio con taquillas y bancos"
              width="900"
              height="550"
              loading="lazy"
            />
            <figcaption>Vestuarios</figcaption>
          </figure>

          <figure>
            <img
              src="/demo-gimnasio-gym/images/relax.webp"
              alt="Zona de relax con asientos para descansar"
              width="1800"
              height="700"
              loading="lazy"
            />
            <figcaption>Zona de relax</figcaption>
          </figure>
        </div>
      </section>
      <section class="section community-section container" id="comunidad">
        <div class="section-heading">
          <h2>
            La gente que
            <br />
            le da vida
          </h2>
          <p>
            Objetivos propios. Ritmos diferentes.
            <br />
            Ganas compartidas.
          </p>
        </div>
        <div class="community-grid">
          {Array.from({ length: 6 }, (_, i) => (
            <img
              src={`/demo-gimnasio-gym/images/comunidad-${i + 1}.webp`}
              alt={
                [
                  "Un compañero sonríe después de entrenar",
                  "Una mujer disfruta de un descanso tras la sesión",
                  "Un entrenador felicita a una compañera",
                  "Una mujer entrena con cuerdas",
                  "Un compañero descansa sentado",
                  "Una compañera comparte una sonrisa",
                ][i]
              }
              loading="lazy"
              width="420"
              height="420"
            />
          ))}
        </div>
        <p class="community-caption">
          Aquí entrenamos a los campeones del barrio
          <span>Y todo empieza por venir.</span>
        </p>
      </section>
      <section class="section container first-session" id="primera-sesion">
        <div>
          <p class="eyebrow">NO TIENES QUE SABER POR DÓNDE EMPEZAR</p>
          <h2>
            ¿Empiezas
            <br />
            en el gimnasio?
          </h2>
          <p class="section-intro first-session-intro">
            Te acompañamos desde el primer día. No necesitas experiencia previa:
            hablamos de tus objetivos y te orientamos para empezar desde tu
            nivel.
          </p>
          <ol class="steps">
            <li>
              <span>01</span>
              <div>
                <h3>Te recibimos</h3>
                <p>Conoce el espacio y a quien te va a acompañar.</p>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <h3>Hablamos de tu objetivo</h3>
                <p>Escuchamos qué buscas y desde dónde empiezas.</p>
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <h3>Entrenamos contigo</h3>
                <p>Una primera sesión adaptada a tu ritmo.</p>
              </div>
            </li>
          </ol>
        </div>
        <img
          src="/demo-gimnasio-gym/images/sesion.webp"
          alt="Una entrenadora conversa con una nueva compañera en su primera sesión"
          width="650"
          height="560"
          loading="lazy"
        />
      </section>
      <section class="section container faq-section" id="preguntas">
        <h2>
          Preguntas sobre
          <br />
          empezar a entrenar
        </h2>
        <div class="faq-list">
          {faqs.map(([q, a]) => (
            <details>
              <summary>
                {q}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>
      <section class="booking-section" id="reserva">
        <div class="container">
          <p class="eyebrow">TU SIGUIENTE PASO EMPIEZA AQUÍ</p>
          <h2>
            Reserva tu
            <br />
            sesión de prueba<span>.</span>
          </h2>
          <form id="booking-form">
            <div class="form-grid">
              <label>
                Nombre
                <input
                  name="nombre"
                  placeholder="¿Cómo te llamas?"
                  autocomplete="given-name"
                  required
                  maxlength="80"
                />
              </label>
              <label>
                Teléfono
                <input
                  name="telefono"
                  type="tel"
                  placeholder="Tu número de teléfono"
                  autocomplete="tel"
                  pattern="[+0-9 ()-]{9,20}"
                  required
                />
              </label>
              <label>
                Franja horaria
                <select name="franja" required>
                  <option value="">¿Cuándo te viene bien?</option>
                  <option>Mañana</option>
                  <option>Mediodía</option>
                  <option>Tarde</option>
                </select>
              </label>
            </div>
            <div class="form-bottom">
              <button class="button button-black" type="submit">
                Solicitar mi prueba <span aria-hidden="true">↗</span>
              </button>
              <p>
                Demo de DPM Evolución Digital.
                <br />
                Este formulario no envía ni guarda datos.
              </p>
            </div>
            <p id="form-status" role="status" hidden></p>
          </form>
        </div>
      </section>
    </main>
    <footer class="footer container">
      <div class="footer-main">
        <a class="wordmark" href="#inicio">
          A TU
          <br />
          RITMO<span>.</span>
        </a>
        <div>
          <h3>El gimnasio</h3>
          <a href="#gimnasio">Instalaciones</a>
          <a href="#primera-sesion">Tu primera sesión</a>
          <a href="#comunidad">La comunidad</a>
        </div>
        <div>
          <h3>Entrenamientos</h3>
          <a href="#entrenamientos">Fuerza</a>
          <a href="#entrenamientos">Funcional</a>
          <a href="#entrenamientos">Entrenamiento personal</a>
          <a href="#clases">Clases en grupo</a>
        </div>
        <div>
          <h3>Contacto</h3>
          <a href="#reserva">Reserva tu prueba</a>
          <a href="#preguntas">Resuelve tus dudas</a>
          <a href="#primera-sesion">Tu primera sesión</a>
        </div>
        <div>
          <h3>Barcelona</h3>
          <p>
            Tu barrio.
            <br />
            Tu gimnasio.
            <br />A tu ritmo.
          </p>
        </div>
      </div>
      <div class="footer-bottom">
        <span>DEMO DE DPM EVOLUCIÓN DIGITAL · IMÁGENES CREADAS CON IA</span>
        <span>Diseñada para empezar. Hecha para seguir.</span>
        <a href="#inicio" aria-label="Volver arriba">
          ↑
        </a>
      </div>
    </footer>
    <dialog id="schedule-dialog" class="modal" aria-labelledby="schedule-title">
      <button class="modal-close" data-close aria-label="Cerrar horarios">
        ×
      </button>
      <p class="eyebrow">ENCUENTRA TU MOMENTO</p>
      <h2 id="schedule-title">Horarios de clases</h2>
      <p class="modal-note">Horario ilustrativo de esta demo.</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Clase</th>
              <th>Días</th>
              <th>Horario</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Circuito</td>
              <td>Lun · Mié · Vie</td>
              <td>09:00 · 18:30</td>
            </tr>
            <tr>
              <td>Fuerza en grupo</td>
              <td>Mar · Jue</td>
              <td>10:00 · 19:00</td>
            </tr>
            <tr>
              <td>Movilidad</td>
              <td>Lun · Mié · Vie</td>
              <td>12:00 · 20:00</td>
            </tr>
            <tr>
              <td>Boxeo</td>
              <td>Mar · Jue</td>
              <td>11:00 · 20:00</td>
            </tr>
            <tr>
              <td>Spinning</td>
              <td>Lun · Mié · Vie</td>
              <td>07:30 · 19:30</td>
            </tr>
            <tr>
              <td>Yoga</td>
              <td>Mar · Jue · Sáb</td>
              <td>09:00 · 18:00</td>
            </tr>
          </tbody>
        </table>
      </div>
      <a class="button" href="#reserva" id="schedule-book">
        Reserva tu prueba ↗
      </a>
    </dialog>

    <dialog
      id="spot-dialog"
      class="modal spot-modal"
      aria-labelledby="spot-title"
    >
      <button class="modal-close" data-close aria-label="Cerrar spot">
        ×
      </button>

      <p class="eyebrow">GYM PRESENTA</p>
      <h2 id="spot-title">TÚ PUEDES</h2>

      <div class="video-frame">
        <iframe
          id="spot-youtube"
          title="TÚ PUEDES · Spot GYM"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </dialog>

    <script>
      const menu = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#main-nav");
      menu?.addEventListener("click", () => {
        const open = menu.getAttribute("aria-expanded") !== "true";
        menu.setAttribute("aria-expanded", String(open));
        menu.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
        nav?.classList.toggle("open", open);
      });
      nav?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          menu?.setAttribute("aria-expanded", "false");
          menu?.setAttribute("aria-label", "Abrir menú");
          nav.classList.remove("open");
        }),
      );
      // Carrusel: un índice y un indicador por actividad.
      const slider = document.querySelector<HTMLElement>(".class-slider");

      if (slider) {
        const cards = Array.from(
          slider.querySelectorAll<HTMLElement>(".class-card"),
        );
        const section = slider.closest(".classes-section");
        const dotsContainer =
          section?.querySelector<HTMLElement>(".slider-dots");
        const previousButton =
          section?.querySelector<HTMLButtonElement>('[data-slide="-1"]');
        const nextButton =
          section?.querySelector<HTMLButtonElement>('[data-slide="1"]');
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );

        let currentIndex = 0;
        const dots = cards.map(() => document.createElement("i"));
        dotsContainer?.replaceChildren(...dots);

        const updateControls = () => {
          dots.forEach((dot, index) => {
            dot.classList.toggle("active", index === currentIndex);
          });
          cards.forEach((card, index) => {
            if (index === currentIndex) {
              card.setAttribute("aria-current", "true");
            } else {
              card.removeAttribute("aria-current");
            }
          });
          if (previousButton) previousButton.disabled = currentIndex === 0;
          if (nextButton) {
            nextButton.disabled =
              !cards.length || currentIndex === cards.length - 1;
          }
        };

        const showCard = (index: number, animate = true) => {
          if (!cards.length) return;
          currentIndex = Math.max(0, Math.min(index, cards.length - 1));
          const targetLeft =
            cards[currentIndex].getBoundingClientRect().left -
            cards[0].getBoundingClientRect().left;

          slider.scrollTo({
            left: targetLeft,
            behavior: animate && !reducedMotion.matches ? "smooth" : "instant",
          });
          updateControls();
        };

        previousButton?.addEventListener("click", () => {
          showCard(currentIndex - 1);
        });
        nextButton?.addEventListener("click", () => {
          showCard(currentIndex + 1);
        });
        slider.addEventListener("keydown", (event) => {
          if (event.target !== slider) return;
          if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
            event.preventDefault();
            showCard(currentIndex + (event.key === "ArrowRight" ? 1 : -1));
          }
        });
        window.addEventListener("resize", () => showCard(currentIndex, false));
        showCard(0, false);
      }

      const schedule =
        document.querySelector<HTMLDialogElement>("#schedule-dialog");
      const spot = document.querySelector<HTMLDialogElement>("#spot-dialog");
      const openModal = (dialog: HTMLDialogElement | null) => {
        if (!dialog || dialog.open) return;
        dialog.showModal();
        document.body.classList.add("modal-open");
      };
      // Abrir la ventana de horarios.
      document
        .querySelector("#schedule-open")
        ?.addEventListener("click", () => openModal(schedule));

      // Reproductor de YouTube.
      const youtubePlayer =
        document.querySelector<HTMLIFrameElement>("#spot-youtube");

      const youtubeUrl =
        "https://www.youtube-nocookie.com/embed/9X0jQtDB_qs?autoplay=1&playsinline=1&controls=0";

      // Abrir el spot y cargar el vídeo.
      document.querySelectorAll("[data-spot]").forEach((button) => {
        button.addEventListener("click", () => {
          openModal(spot);

          if (youtubePlayer) {
            youtubePlayer.src = youtubeUrl;
          }
        });
      });

      // Cerrar las ventanas con su botón o pulsando fuera.
      document
        .querySelectorAll<HTMLDialogElement>("dialog")
        .forEach((dialog) => {
          dialog
            .querySelector("[data-close]")
            ?.addEventListener("click", () => dialog.close());

          dialog.addEventListener("click", (event) => {
            if (event.target !== dialog) return;

            const rect = dialog.getBoundingClientRect();

            const clickedOutside =
              event.clientX < rect.left ||
              event.clientX > rect.right ||
              event.clientY < rect.top ||
              event.clientY > rect.bottom;

            if (clickedOutside) {
              dialog.close();
            }
          });

          dialog.addEventListener("close", () => {
            document.body.classList.toggle(
              "modal-open",
              document.querySelector("dialog[open]") !== null,
            );

            // Detener el vídeo al cerrar la ventana del spot.
            if (dialog.id === "spot-dialog") {
              youtubePlayer?.removeAttribute("src");
            }
          });
        });

      // Cerrar los horarios al ir al formulario de reserva.
      document
        .querySelector("#schedule-book")
        ?.addEventListener("click", () => schedule?.close());

      // Formulario de demostración: no envía ni guarda datos.
      document
        .querySelector<HTMLFormElement>("#booking-form")
        ?.addEventListener("submit", (event) => {
          event.preventDefault();

          const status = document.querySelector<HTMLElement>("#form-status");

          if (status) {
            status.hidden = false;
            status.textContent =
              "¡Ya has dado el primer paso! Has completado la reserva de demostración. No se han enviado ni guardado tus datos.";
          }
        });

      // Franja que alterna frases y colores.
      {
        const banner = document.querySelector<HTMLElement>(".rhythm-banner");

        if (banner && banner.querySelector(".rhythm-banner__message")) {
          const messages = Array.from(
            banner.querySelectorAll<HTMLElement>(".rhythm-banner__message"),
          );

          const pauseButton = banner.querySelector<HTMLButtonElement>(
            ".rhythm-banner__pause",
          );

          const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          );

          let currentMessage = 0;
          let isVisible = false;
          let isPaused = false;
          let timer: ReturnType<typeof setInterval> | undefined;

          // Prepara las letras manteniendo cada palabra unida.
          // Todas las letras reservan su espacio antes de aparecer.
          messages.forEach((message) => {
            let letterIndex = 0;

            message
              .querySelectorAll<HTMLElement>(".rhythm-banner__line")
              .forEach((line) => {
                const text = (line.textContent ?? "")
                  .trim()
                  .replace(/\s+/g, " ");
                const fragment = document.createDocumentFragment();

                text.split(/(\s+)/).forEach((part) => {
                  if (/^\s+$/.test(part)) {
                    fragment.append(document.createTextNode(part));
                    return;
                  }

                  const word = document.createElement("span");
                  word.className = "rhythm-banner__word";

                  Array.from(part).forEach((character) => {
                    const letter = document.createElement("span");

                    letter.className = "rhythm-banner__letter";
                    letter.textContent = character;
                    letter.style.setProperty(
                      "--letter-delay",
                      `${letterIndex * 35}ms`,
                    );

                    word.append(letter);
                    letterIndex += 1;
                  });

                  fragment.append(word);
                });

                line.replaceChildren(fragment);
              });
          });

          const showMessage = () => {
            messages.forEach((message, index) => {
              message.classList.toggle("is-active", index === currentMessage);
            });

            banner.classList.toggle("is-dark", currentMessage === 1);
          };

          const stopAnimation = () => {
            if (timer !== undefined) {
              window.clearInterval(timer);
              timer = undefined;
            }

            // Al detenerla, deja la frase completa visible.
            banner.classList.remove("is-animating");
          };

          const updateAnimation = () => {
            stopAnimation();

            if (
              !isVisible ||
              isPaused ||
              document.hidden ||
              reducedMotion.matches
            ) {
              return;
            }

            banner.classList.add("is-animating");

            timer = window.setInterval(() => {
              currentMessage = (currentMessage + 1) % messages.length;
              showMessage();
            }, 5500);
          };

          pauseButton?.addEventListener("click", () => {
            isPaused = !isPaused;

            pauseButton.setAttribute("aria-pressed", String(isPaused));
            pauseButton.textContent = isPaused
              ? "Reanudar animación"
              : "Pausar animación";

            updateAnimation();
          });

          const observer = new IntersectionObserver(
            ([entry]) => {
              if (isVisible === entry.isIntersecting) return;
              isVisible = entry.isIntersecting;
              updateAnimation();
            },
            { threshold: 0.15 },
          );

          observer.observe(banner);

          document.addEventListener("visibilitychange", updateAnimation);
          reducedMotion.addEventListener("change", updateAnimation);
        }
      }

      // Carrusel de instalaciones, independiente del carrusel de clases.
      {
        const section = document.querySelector<HTMLElement>("#gimnasio");
        const slider = section?.querySelector<HTMLElement>(".spaces-slider");
        const previous = section?.querySelector<HTMLButtonElement>(
          '[data-space-direction="-1"]',
        );
        const next = section?.querySelector<HTMLButtonElement>(
          '[data-space-direction="1"]',
        );

        if (slider) {
          const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          );
          const updateControls = () => {
            const maxScroll = Math.max(
              0,
              slider.scrollWidth - slider.clientWidth,
            );
            if (previous) previous.disabled = slider.scrollLeft <= 2;
            if (next) next.disabled = slider.scrollLeft >= maxScroll - 2;
          };
          const move = (direction: number) => {
            const card = slider.querySelector<HTMLElement>("figure");
            if (!card) return;
            const gap = parseFloat(getComputedStyle(slider).columnGap) || 0;
            slider.scrollBy({
              left: (card.getBoundingClientRect().width + gap) * direction,
              behavior: reducedMotion.matches ? "instant" : "smooth",
            });
          };
          previous?.addEventListener("click", () => move(-1));
          next?.addEventListener("click", () => move(1));
          slider.addEventListener("scroll", updateControls, { passive: true });
          slider.addEventListener("keydown", (event) => {
            if (event.target !== slider) return;
            if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
              event.preventDefault();
              move(event.key === "ArrowRight" ? 1 : -1);
            }
          });
          const resizeObserver = new ResizeObserver(updateControls);
          resizeObserver.observe(slider);
          updateControls();
        }
      }
    </script>
  </body>
</html>
